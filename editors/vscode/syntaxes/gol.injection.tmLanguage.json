{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "gosling.injection",
  "injectionSelector": "L:source.gol -string -comment, L:meta.template.expression.gol -string.quoted -comment",
  "patterns": [
    {
      "include": "#template"
    },
    {
      "include": "#regex"
    },
    {
      "include": "#catch"
    },
    {
      "include": "#exception-keywords"
    },
    {
      "include": "#generator"
    },
    {
      "include": "#yield"
    },
    {
      "include": "#for-of-in"
    },
    {
      "include": "#using"
    },
    {
      "include": "#let"
    },
    {
      "include": "#union"
    },
    {
      "include": "#enum"
    },
    {
      "include": "#impl"
    },
    {
      "include": "#constructor"
    },
    {
      "include": "#this"
    },
    {
      "include": "#instanceof"
    },
    {
      "include": "#arrow"
    },
    {
      "include": "#optional-parameter"
    },
    {
      "include": "#as"
    },
    {
      "include": "#optional-chaining"
    },
    {
      "include": "#nullish"
    },
    {
      "include": "#ternary"
    }
  ],
  "repository": {
    "template": {
      "name": "string.template.gol",
      "begin": "\\b(?:(t)|(\\w+))(`)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.template.gol"
        },
        "2": {
          "name": "entity.name.function.tag.gol"
        },
        "3": {
          "name": "punctuation.definition.string.template.begin.gol"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.gol"
        }
      },
      "patterns": [
        {
          "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.|$)",
          "name": "constant.character.escape.gol"
        },
        {
          "include": "#template-expression"
        }
      ]
    },
    "template-expression": {
      "name": "meta.template.expression.gol",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.gol"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.gol"
        }
      },
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "source.gol"
        }
      ]
    },
    "braces": {
      "comment": "Keeps a composite literal's closing brace from ending a template expression.",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.begin.bracket.curly.gol"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.end.bracket.curly.gol"
        }
      },
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "source.gol"
        }
      ]
    },
    "regex": {
      "comment": "A / starts a regex literal only where an operand starts, as in JavaScript.",
      "match": "(?:(?<=^)|(?<=[=(,:\\[{!&|?;+\\-*%<>^])|(?<=\\breturn))\\s*(/)(?![/*])((?:\\\\.|\\[(?:\\\\.|[^\\]\\\\\\n])*\\]|[^/\\\\\\[\\n])+)(/)([a-zA-Z]*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.string.begin.regexp.gol"
        },
        "2": {
          "name": "string.regexp.gol"
        },
        "3": {
          "name": "punctuation.definition.string.end.regexp.gol"
        },
        "4": {
          "name": "keyword.other.regexp-flags.gol"
        }
      }
    },
    "catch": {
      "match": "\\b(catch)(?:\\s+(panic)\\b)?(?:\\s*(\\()\\s*(\\w+)\\s*(?:(\\))|(:)|(is)\\b))?",
      "captures": {
        "1": {
          "name": "keyword.control.exception.gol"
        },
        "2": {
          "name": "keyword.control.exception.gol"
        },
        "3": {
          "name": "punctuation.definition.begin.bracket.round.gol"
        },
        "4": {
          "name": "variable.parameter.gol"
        },
        "5": {
          "name": "punctuation.definition.end.bracket.round.gol"
        },
        "6": {
          "name": "punctuation.separator.type.gol"
        },
        "7": {
          "name": "keyword.operator.is.gol"
        }
      }
    },
    "exception-keywords": {
      "match": "\\b(?:try|catch|finally|throw)\\b",
      "name": "keyword.control.exception.gol"
    },
    "generator": {
      "match": "\\b(func)(\\*)",
      "captures": {
        "1": {
          "name": "keyword.function.go"
        },
        "2": {
          "name": "keyword.generator.asterisk.gol"
        }
      }
    },
    "yield": {
      "match": "^\\s*(yield)(\\*)?(?=\\s)",
      "captures": {
        "1": {
          "name": "keyword.control.flow.yield.gol"
        },
        "2": {
          "name": "keyword.generator.asterisk.gol"
        }
      }
    },
    "for-of-in": {
      "match": "\\b(for)\\s*(\\()\\s*(?:(let)|(const))\\s+((?:\\w+\\s*,\\s*)*\\w+)\\s+(?:(of)|(in))\\b",
      "captures": {
        "1": {
          "name": "keyword.control.gol"
        },
        "2": {
          "name": "punctuation.definition.begin.bracket.round.gol"
        },
        "3": {
          "name": "keyword.let.gol"
        },
        "4": {
          "name": "keyword.const.gol"
        },
        "5": {
          "patterns": [
            {
              "match": "\\w+",
              "name": "variable.other.declaration.gol"
            },
            {
              "match": ",",
              "name": "punctuation.separator.comma.gol"
            }
          ]
        },
        "6": {
          "name": "keyword.operator.of.gol"
        },
        "7": {
          "name": "keyword.operator.in.gol"
        }
      }
    },
    "using": {
      "match": "^\\s*(using)\\s+(\\w+)\\s*(?==[^=])",
      "captures": {
        "1": {
          "name": "keyword.using.gol"
        },
        "2": {
          "name": "variable.other.declaration.gol"
        }
      }
    },
    "let": {
      "patterns": [
        {
          "comment": "Composite and func types fall through to the Go grammar.",
          "match": "\\b(let)\\s+((?:\\w+\\s*,\\s*)*\\w+)(?:\\s*(:)\\s*(?!(?:func|map|chan|struct|interface)\\b)((?:\\[\\d*\\]|\\*)*)((?:\\w+\\.)?\\w+))?",
          "captures": {
            "1": {
              "name": "keyword.let.gol"
            },
            "2": {
              "patterns": [
                {
                  "match": "\\w+",
                  "name": "variable.other.declaration.gol"
                },
                {
                  "match": ",",
                  "name": "punctuation.separator.comma.gol"
                }
              ]
            },
            "3": {
              "name": "punctuation.separator.type.gol"
            },
            "4": {
              "patterns": [
                {
                  "include": "source.go"
                }
              ]
            },
            "5": {
              "name": "entity.name.type.gol",
              "patterns": [
                {
                  "match": "\\b(?:any|bool|byte|comparable|complex64|complex128|error|float32|float64|int|int8|int16|int32|int64|rune|string|uint|uint8|uint16|uint32|uint64|uintptr)\\b",
                  "name": "storage.type.gol"
                }
              ]
            }
          }
        },
        {
          "match": "\\blet\\b",
          "name": "keyword.let.gol"
        }
      ]
    },
    "union": {
      "begin": "\\b(type)\\s+(\\w+)\\s*(=)(?=[^|/]*\\|)",
      "beginCaptures": {
        "1": {
          "name": "keyword.type.gol"
        },
        "2": {
          "name": "entity.name.type.gol"
        },
        "3": {
          "name": "keyword.operator.assignment.gol"
        }
      },
      "end": "(?=\\s*(?://|/\\*|$))",
      "patterns": [
        {
          "match": "\\|",
          "name": "punctuation.separator.union.gol"
        },
        {
          "match": "\\*",
          "name": "keyword.operator.address.gol"
        },
        {
          "match": "(?:\\w+\\.)?\\w+",
          "name": "entity.name.type.gol"
        }
      ]
    },
    "enum": {
      "begin": "\\b(enum)\\s+(\\w+)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.enum.gol"
        },
        "2": {
          "name": "entity.name.type.gol"
        },
        "3": {
          "name": "punctuation.definition.begin.bracket.curly.gol"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.end.bracket.curly.gol"
        }
      },
      "patterns": [
        {
          "match": "(?:^|(?<=[{,]))\\s*([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "variable.other.constant.gol"
            }
          }
        },
        {
          "include": "source.go"
        }
      ]
    },
    "impl": {
      "match": "^\\s*(impl)\\s+(\\w+)(?:\\[[^\\]]*\\])?(?:\\s+(implements)\\b)?",
      "captures": {
        "1": {
          "name": "keyword.other.impl.gol"
        },
        "2": {
          "name": "entity.name.type.gol"
        },
        "3": {
          "name": "keyword.other.implements.gol"
        }
      }
    },
    "constructor": {
      "match": "^\\s*(constructor)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "storage.type.function.constructor.gol"
        }
      }
    },
    "this": {
      "match": "\\bthis\\b",
      "name": "variable.language.this.gol"
    },
    "instanceof": {
      "match": "\\b(instanceof)\\b(?:\\s+(\\*?)((?:\\w+\\.)?\\w+))?",
      "captures": {
        "1": {
          "name": "keyword.operator.instanceof.gol"
        },
        "2": {
          "name": "keyword.operator.address.gol"
        },
        "3": {
          "name": "entity.name.type.gol"
        }
      }
    },
    "arrow": {
      "patterns": [
        {
          "match": "\\b(\\w+)\\s*(=>)",
          "captures": {
            "1": {
              "name": "variable.parameter.gol"
            },
            "2": {
              "name": "storage.type.function.arrow.gol"
            }
          }
        },
        {
          "match": "=>",
          "name": "storage.type.function.arrow.gol"
        }
      ]
    },
    "optional-parameter": {
      "match": "\\b(\\w+)(\\?)(?=\\s+[\\w*\\[])",
      "captures": {
        "1": {
          "name": "variable.parameter.gol"
        },
        "2": {
          "name": "keyword.operator.optional.gol"
        }
      }
    },
    "as": {
      "match": "(?<=[\\w)\\]}\"`])\\s+(as)(?=\\s+(?:[\\w*\\[]|<-))",
      "captures": {
        "1": {
          "name": "keyword.control.as.gol"
        }
      }
    },
    "optional-chaining": {
      "match": "\\?\\.",
      "name": "punctuation.accessor.optional.gol"
    },
    "nullish": {
      "match": "\\?\\?",
      "name": "keyword.operator.nullish.gol"
    },
    "ternary": {
      "match": "\\?(?![?.])",
      "name": "keyword.operator.ternary.gol"
    }
  }
}
