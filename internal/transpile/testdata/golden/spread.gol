package spread

import "time"

type User struct {
	name string
	age  int
	tags []string
}

type Point struct{ X, Y int }

func shorthand(name string, age int) User {
	return User{name, age}
}

func mixed(name string) User {
	return User{name, age: 3}
}

func positionalKeepsMeaning(X, Y int) Point {
	return Point{Y, X}
}

func concat(a, b []int, x int) []int {
	return [...a, x, 7, ...b]
}

func copySlice(a []string) []string {
	return [...a]
}

func update(p Point) Point {
	return Point{...p, X: 5}
}

func updateShorthand(u User, age int) User {
	return User{...u, age, tags: [...u.tags, "new"]}
}

func leadingElements(a []int, x int) [][]int {
	return [][]int{[x, ...a], [x, 1, ...a, ...a, 2]}
}

func copyWithTrailingComma(p Point) Point {
	return Point{...p,
	}
}

func updateWithTrailingComma(p Point) Point {
	return Point{
		...p,
		X: 1,
	}
}

func updatePointer(p *Point) *Point {
	return &Point{...*p, Y: 2}
}

func updateWithComments(u User, age int) User {
	return User{...u, // keep the base
		// the new age
		age, /* inline */ name: "x", // trailing name
		tags: nil, // last
		// before close
	}
}

func spreadAfterComment(p Point) Point {
	return Point{ // copy p
		...p,
		Y: 1,
	}
}

type ID int64

func typedConstants(ids []ID, waits []time.Duration) ([]ID, []time.Duration) {
	return [...ids, 1, ...ids, 2], [...waits, 5, time.Second]
}

type Counts map[string]int

func mergeMaps(defaults, overrides Counts, n int) Counts {
	return Counts{...defaults, ...overrides, "n": n}
}

func mergeLiteral(a map[string][]int) map[string][]int {
	return map[string][]int{"first": {1}, ...a}
}

func mergeUntyped(a, b map[string]Point) map[string]Point {
	let m = {...a, "origin": {0, 0}, ...b}
	return m
}

func untypedStruct(p Point) Point {
	return {...p, Y: 1}
}

func mergePointers(a map[Point]*Point) map[Point]*Point {
	return map[Point]*Point{...a, {1, 2}: {3, 4}}
}
