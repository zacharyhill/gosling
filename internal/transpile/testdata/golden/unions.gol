package unions

import "math"

type Circle struct{ R float64 }

type Square struct{ Side float64 }

type Polygon struct{ Points [][2]float64 }

// Shape is any drawable shape.
type Shape = Circle | Square | *Polygon

func area(s Shape) float64 {
	switch let s = s.(type) {
	case Circle:
		return math.Pi * s.R * s.R
	case Square:
		return s.Side * s.Side
	case *Polygon:
		return 0
	}
	return 0
}

func name(s Shape) string {
	switch s.(type) {
	case Circle:
		return "circle"
	default:
		return "other"
	}
}

func withNil(s Shape) bool {
	switch s.(type) {
	case nil:
		return false
	case Circle, Square, *Polygon:
		return true
	}
	return false
}
