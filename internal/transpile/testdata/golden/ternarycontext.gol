package ternarycontext

import (
	"fmt"
	"io"
	"strings"
)

type Name struct{ Value string }

func (name *Name) String() string { return name.Value }

type Failure struct{}

func (*Failure) Error() string { return "failure" }

func declared(ok: bool): fmt.Stringer {
	let stringer: fmt.Stringer = ok ? &Name{"a"} : nil
	return stringer
}

func constant(ok: bool, input: io.Reader): io.Reader {
	const reader: io.Reader = ok ? input : strings.NewReader("")
	return reader
}

func returned(ok: bool): error {
	return ok ? nil : &Failure{}
}

func assigned(ok: bool): fmt.Stringer {
	let stringer: fmt.Stringer
	stringer = ok ? &Name{"b"} : nil
	return stringer
}

func isNil(stringer: fmt.Stringer): bool { return stringer == nil }

func passed(ok: bool): bool {
	return isNil(ok ? &Name{"c"} : nil)
}

func listed(ok: bool): []fmt.Stringer {
	return []fmt.Stringer{ok ? &Name{"d"} : nil}
}

func chained(count: int): error {
	return count < 0 ? &Failure{} : count == 0 ? &Failure{} : nil
}
