package catchdecl

import "os"

func typeFirst() int {
	try {
		os.Remove("a")
	} catch {
		type code int
		return int(code(1))
	}
	return 0
}

func constFirst() int {
	try {
		os.Remove("a")
	} catch {
		const fallback = 2
		return fallback
	}
	return 0
}

func letFirst() int {
	try {
		os.Remove("a")
	} catch {
		let count: int
		count++
		return count
	}
	return 0
}

func boundTypeFirst() string {
	try {
		os.Remove("a")
	} catch (e) {
		type message string
		return string(message(e.Error()))
	}
	return ""
}
