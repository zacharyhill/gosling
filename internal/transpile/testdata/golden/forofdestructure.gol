package forofdestructure

type Config struct {
	Name string
	Port int
}

func ports(configs []Config) map[string]int {
	const out = map[string]int{}
	for (const {Name, Port: port} of configs) {
		out[Name] = port
	}
	return out
}

func sums(pairs [][2]int) []int {
	let out: []int
	for (let [a, b] of pairs) {
		a += b
		out = append(out, a)
	}
	return out
}

func literal() string {
	let joined = ""
	for (const [k, v] of [][2]string{{"a", "1"}, {"b", "2"}}) { joined += k + v }
	return joined
}
