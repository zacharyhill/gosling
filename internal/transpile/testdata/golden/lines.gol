package lines

import (
	"encoding/json"
	"fmt"
	"os"
)

type Config struct {
	Name string
}

// Load reads and parses a config file.
func Load(path string) (Config, error) {
	let cfg: Config
	try {
		let data = os.ReadFile(path) // read it
		json.Unmarshal(data, &cfg)
	} catch (e) {
		return Config{}, fmt.Errorf("load: %w", e)
	}
	return cfg, nil
}

func join(parts []string, values ...any) string {
	return fmt.Sprint(parts, values)
}

func query(id int) string {
	let text = join`select *
from t
where id = ${id}`
	return text
}

func after() int {
	return 1
}
