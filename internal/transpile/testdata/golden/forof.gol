package forof

func sum(xs []int) int {
	let total = 0
	for (const x of xs) {
		total += x
	}
	return total
}

func keys(m map[string]int) []string {
	let out: []string
	for (let k in m) {
		out = append(out, k)
	}
	return out
}

func literal() int {
	let n = 0
	for (const v of []int{1, 2, 3}) {
		n += v
	}
	return n
}
