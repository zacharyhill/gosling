package forof

import "iter"

func sum(xs []int) int {
	let total = 0
	for (const x of xs) {
		total += x
	}
	return total
}

func keys(m map[string]int) []string {
	let out: []string
	for (let k in m) {
		out = append(out, k)
	}
	return out
}

func literal() int {
	let n = 0
	for (const v of []int{1, 2, 3}) {
		n += v
	}
	return n
}

func drain(ch <-chan string) []string {
	let out: []string
	for (const s of ch) {
		out = append(out, s)
	}
	return out
}

func countTo(n int) int {
	let total = 0
	for (let i of n) {
		i *= 2
		total += i
	}
	for (const i of 3) {
		total += i
	}
	return total
}

func sumSeq(seq iter.Seq[int], pairs iter.Seq2[string, int]) int {
	let total = 0
	for (const x of seq) {
		total += x
	}
	for (const v of pairs) {
		total += v
	}
	return total
}
