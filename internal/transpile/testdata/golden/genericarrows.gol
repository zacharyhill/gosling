package genericarrows

import (
	"cmp"
	"fmt"
)

// identity returns its argument.
const identity = <T>(x T) => x

const keys = <K comparable, V>(m map[K]V) => {
	let out: []K
	for (const k in m) {
		out = append(out, k)
	}
	return out
}

const maxOf = <T cmp.Ordered>(a T, b T) => {
	if a > b {
		return a
	}
	return b
}

const describe = <T fmt.Stringer>(xs []T) => xs.map(x => x.String())

const total = <T int | float64>(xs []T) => xs.reduce((sum, x) => sum + x, T(0))

func use() int {
	return identity(1) + maxOf(2, 3) + len(keys(map[string]bool{})) + total([]int{4})
}
