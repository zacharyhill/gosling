package main

import "fmt"

enum Direction { North, East, South, West }

enum Priority {
	Low = 10
	Medium
	High = 20
}

enum Format {
	JSON = "json"
	YAML = "yaml"
}

func turn(direction Direction) Direction {
	switch direction {
	case Direction.North:
		return Direction.East
	case Direction.East:
		return DirectionSouth
	case Direction.South:
		return Direction.West
	case Direction.West:
		return Direction.North
	}
	return direction
}

func main() {
	let headings = []Direction{Direction.North}
	for (let step = 0; step < 4; step++) {
		headings = append(headings, turn(headings[step]))
	}
	fmt.Println(headings)
	fmt.Println(Priority.Low, int(Priority.Medium), Priority.High, Priority(99))
	fmt.Println(Format.JSON, string(Format.YAML) == "yaml")
	fmt.Println(t`heading ${Direction.West} at ${Priority.Medium}`)
	fmt.Printf("%d %v %s\n", Direction.South, Direction(7), Format.YAML)
	const urgent = len(headings) > 3 ? Priority.High : Priority.Low
	const {Facing} = struct{ Facing Direction }{Direction.East}
	fmt.Println(urgent, Facing, t`${Priority.Medium:d}`)
}
