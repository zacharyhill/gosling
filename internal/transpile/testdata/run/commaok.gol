package main

import "fmt"

type Cache struct{ ports map[string]int }

func main() {
	const ports = map[string]int{"http": 80}
	const [port, found] = ports["http"]
	const [_, missing] = ports["gopher"]
	fmt.Println(port, found, missing)

	const cache = Cache{ports}
	let n: int
	let ok: bool
	[n, ok] = cache.ports["http"]
	fmt.Println(n, ok)

	let value: any = 42
	const [number, isInt] = value.(int)
	const [text, isString] = value.(string)
	fmt.Println(number, isInt, text == "", isString)

	const messages = make(chan string, 1)
	messages <- "hi"
	close(messages)
	const [first, open] = <-messages
	const [second, stillOpen] = <-messages
	fmt.Println(first, open, second == "", stillOpen)

	const [a, b] = [2]int{1, 2}
	fmt.Println(a, b)
}
