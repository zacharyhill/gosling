package main

import "fmt"

type Point struct{ X, Y int }

type Counts map[string]int

type User struct {
	name string
	age  int
}

func main() {
	let a = []int{1, 2}
	let b = [...a, 3]
	b[0] = 99
	fmt.Println(a, b, [...a, ...b])
	fmt.Println([0, ...a], [0, 1, ...a, 5])
	let p = Point{1, 2}
	let q = Point{...p, Y: 20}
	fmt.Println(p, q)
	let r = &Point{...p, X: 7}
	r.Y = 8
	fmt.Println(p, *r)
	let name, age = "ada", 36
	let u = User{name, age}
	fmt.Println(u, User{...u, name: "grace"})
	let big = []int64{1}
	let halves = [...[]float32{0.5}, 2]
	fmt.Println([...big, 2, 3], [...big, 4, ...big], halves)
	let defaults = map[string]int{"a": 1, "b": 2}
	let merged = {...defaults, "b": 20, "c": 30}
	merged["a"] = 100
	fmt.Println(defaults, merged, Counts{"a": 5, ...defaults})
	let none: map[string]int
	fmt.Println(len({...none}), {...none} != nil, {...p, X: 7})
	let counts = &Counts{
		...defaults, // base
		"z": 26,
	}
	fmt.Println((*counts)["z"], len(*counts))
	let parts = []any{"spread", 1}
	fmt.Println(...parts)
	fmt.Println(append(a, ...b, 9), a)
}
