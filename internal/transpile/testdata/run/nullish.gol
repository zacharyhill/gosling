package main

import (
	"fmt"
	"strings"
)

type Profile struct{ Name string }

type User struct {
	Profile *Profile
}

func (u *User) Greet() string { return "hi " + (u.Profile?.Name ?? "?") }

type Config struct{ Port *int }

var counter int

func profileName[P interface {
	*User
	Name() string
}](u P) string {
	return u?.Name() ?? "generic"
}

func (u *User) Name() string { return u.Profile?.Name ?? "unnamed" }

func firstSet[P ~*int](values ...P) P {
	return values[0] ?? values[1]
}

type IntPointer *int

func orOne[P ~*int](v P) int {
	return v ?? 1
}

func firstOrTwo[P *int | IntPointer](a, b P) int {
	return a ?? b ?? 2
}

func next() *User {
	counter++
	return &User{Profile: &Profile{Name: "ada"}}
}

func main() {
	let nobody: *User
	let half = &User{}
	let full = &User{Profile: &Profile{Name: "grace"}}
	for (const u of []*User{nobody, half, full}) {
		fmt.Println(u?.Profile?.Name ?? "anon")
	}
	let port = 9000
	fmt.Println(Config{}.Port ?? 8080, Config{Port: &port}.Port ?? 8080)
	fmt.Println(next()?.Profile?.Name ?? "none", counter)
	fmt.Println(t`${strings.ToUpper(full?.Profile?.Name ?? "x")} ${nobody?.Profile?.Name}|`)
	fmt.Println(full.Greet(), (&User{}).Greet())
	fmt.Println(profileName(nobody), profileName(half), profileName(full))
	let one = 1
	fmt.Println(*firstSet(nil, &one))
	let seven = 7
	fmt.Println(orOne[*int](nil), orOne(&seven), firstOrTwo[*int](nil, nil), firstOrTwo(nil, &seven))
	let sb: *strings.Builder
	sb?.WriteString("ignored")
	let cfg = Config{}
	cfg.Port ??= &port
	cfg.Port ??= new(1)
	fmt.Println(*cfg.Port, cfg.Port == &port)
	let present = "here"
	let names = map[string]*string{"a": &present, "b": nil}
	let keys = []string{"a", "b", "c"}
	let lookups = 0
	let key = (i int) => {
		lookups++
		return keys[i]
	}
	for (let i = 0; i < 3; i++) {
		let fallback = t`default ${i}`
		names[key(i)] ??= &fallback
	}
	fmt.Println(*names["a"], *names["b"], *names["c"], lookups)
	let users: []*User
	users ??= []*User{full}
	users[0].Profile ??= &Profile{Name: "unused"}
	fmt.Println(users[0].Profile.Name)
	fmt.Println("done")
}
