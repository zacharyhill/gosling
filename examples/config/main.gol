// Command config loads service configs and prints a report. The comment on
// each function names the gosling features that the function shows.
package main

import (
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strconv"
)

let configFiles = map[string]string{
	"api.json":    `{"name": "api", "protocol": "https", "stage": 2, "level": "info", "tags": ["public", "edge"], "host": "api.internal"}`,
	"worker.json": `{"name": "worker", "protocol": "grpc", "stage": 0, "level": "debug", "tags": []}`,
	"broken.json": `{"name": "broken",`,
}

func main() {
	if const err = runInTempDir(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func runInTempDir(): error {
	const dir, err = os.MkdirTemp("", "gosling-config")
	if err != nil {
		return err
	}
	return errors.Join(run(dir), os.RemoveAll(dir))
}

// run shows a try block, a try expression, a call result pattern, and an
// arrow that gets its types from the context.
func run(dir: string): error {
	try {
		for const name, contents = range configFiles {
			os.WriteFile(filepath.Join(dir, name), []byte(contents), 0o600)
		}
	} catch (err) {
		return fmt.Errorf("write configs: %w", err)
	}

	const sources = []Source{
		FileSource{filepath.Join(dir, "api.json")},
		FileSource{filepath.Join(dir, "worker.json")},
		FileSource{filepath.Join(dir, "broken.json")},
		FileSource{filepath.Join(dir, "missing.json")},
		InlineSource{"billing", `{"name": "billing", "protocol": "http", "stage": 1, "level": "warn", "tags": ["internal"], "port": 8081}`},
		InlineSource{"bad", `{"name": "Bad_Name", "protocol": "http"}`},
	}
	const limit = try strconv.Atoi(os.Getenv("CONFIG_LIMIT")) catch sources.length
	let stats: loadStats
	const [registry, failures] = loadAll(sources[:min(limit, sources.length)], &stats)
	for (const failure of failures) {
		fmt.Println("error:", failure)
	}
	fmt.Println(t`loaded ${registry} from ${stats.Attempts} sources, ${stats.Failures} failed`)

	for (const service of registry.All()) {
		const err = applyHook(service, service => service.Tags[0] == "public" ? nil : fmt.Errorf("first tag is %q", service.Tags[0]))
		if err != nil {
			fmt.Println("hook:", err)
		}
	}

	printReport(registry)
	registry.Remove("billing")
	fmt.Println(t`after remove: ${registry}`)
	return nil
}
