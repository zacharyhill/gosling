// Command config shows how to use the gosling features.
package main

import (
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
)

type Config struct {
	Name string  `json:"name"`
	Port int     `json:"port"`
	Host *string `json:"host"`
}

// load uses one catch block to wrap each failure in its try block.
func load(path string) (Config, error) {
	let config: Config
	try {
		const contents = os.ReadFile(path)
		json.Unmarshal(contents, &config)
	} catch (e) {
		return Config{}, fmt.Errorf("load config: %w", e)
	}
	return config, nil
}

// loadAll uses try/catch to send each failed call in the block to one handler.
func loadAll(paths []string) ([]Config, error) {
	let configs: []Config
	try {
		for (const path of paths) {
			const config = load(path)
			configs = append(configs, config)
		}
	} catch (e) {
		return nil, fmt.Errorf("loading configs: %w", e)
	}
	return configs, nil
}

// describe uses destructuring, for...of, template literals, ??, and array methods.
// Code cannot assign to the names that const declares.
func describe(configs []Config) {
	for (const config of configs) {
		const {Name: name, Port: port} = config
		fmt.Println(t`${name} listens on ${config.Host ?? "localhost"}:${port}`)
	}
	const publicNames = configs.filter(config => config.Port < 10000).map(config => config.Name)
	fmt.Println(t`public services: ${publicNames}`)
}

func main() {
	const dir = os.TempDir()
	const good = filepath.Join(dir, "gosling-good.json")
	try {
		os.WriteFile(good, []byte(`{"name":"api","port":8080}`), 0o600)
		const configs = loadAll([]string{good})
		describe(configs)
		loadAll([]string{good, filepath.Join(dir, "gosling-missing.json")})
	} catch (e) {
		fmt.Println("error:", e)
	}
}
